{
  "manifest_version": 3,
  "name": "GhostPilot — Eşzamanlı AI Fare/Klavye & Masaüstü Köprüsü",
  "short_name": "GhostPilot",
  "version": "1.6.2",
  "description": "Fiziksel farenizi ve klavyenizi engellemeden tarayıcıları, web oyunlarını ve masaüstü pencerelerini kontrol eden ultra hafif hibrit AI eklentisi.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GhostPilot Kontrol Panelini Aç",
    "default_popup": "panel.html"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "identity",
    "windows",
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "debugger",
    "sidePanel",
    "alarms",
    "nativeMessaging",
    "notifications",
    "idle"
  ],
  "host_permissions": [
    "https://api.xkiro.com/*",
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://localhost:11434/*",
    "http://localhost:1234/*",
    "http://localhost:8080/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "emergency-stop": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Alt+Shift+X"
      },
      "description": "Acil Durdurma (Tüm AI tuş basımlarını ve görevleri anında keser)"
    },
    "open-ghostpilot": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "GhostPilot Yan Panelini Aç"
    },
    "toggle-access": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "AI Erişimini Aç / Kapat (anında)"
    }
  },
  "author": {
    "email": "noreply@btmcode.vercel.app"
  },
  "homepage_url": "https://btmcode.vercel.app"
}